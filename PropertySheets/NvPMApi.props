<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="LibraryRoot.props" Condition="'$(LIBS_ROOT)'==''" />
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <NVPMAPI_ROOT>$(LIBS_ROOT)\PerfKit_3.0.1.13135</NVPMAPI_ROOT>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(NVPMAPI_ROOT)\inc\; %(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
	</ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="NVPMAPI_ROOT">
      <Value>$(NVPMAPI_ROOT)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>