<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
<Import Project="LibraryRoot.props" Condition="'$(LIBS_ROOT)'==''"/>
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <ZLIB_ROOT>$(LIBS_ROOT)\zlib-1.2.5\</ZLIB_ROOT>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ZLIB_ROOT); %(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="ZLIB_ROOT">
      <Value>$(ZLIB_ROOT)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>